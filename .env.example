# Comma-separated admin emails. Leave blank to deny all admin access.
# Local Sites preview's mock identity is seedy@sites.test.
# Set the actual owner's email separately in hosted environment variables.
ADMIN_EMAIL=

# libSQL database used by lib/runtime.ts.
# Hosted: a Turso database, e.g. libsql://<name>-<org>.turso.io, plus its token.
# Local: a SQLite file, e.g. file:.data/local.db (created by `node scripts/db-migrate.mjs`).
# Unset outside production, the app falls back to file:.data/local.db.
# Unset in production, the app serves the existing 503 instead of an empty shop.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
