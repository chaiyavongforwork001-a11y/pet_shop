# PAWPAL environment variables.
#
# Local development: copy this file to .env and fill in what you need. .env is
# gitignored. Deployed on Netlify: set these in the Netlify UI instead
# (Site configuration -> Environment variables), never in the repository.
# The owner's step-by-step guide is docs/deploy-netlify.md.

# Comma-separated admin emails. Leave blank to deny all admin access.
# A signed-in Google user whose verified address is in this list is an admin;
# everyone else is an ordinary customer. Set the owner's address here.
ADMIN_EMAIL=

# Signs the session cookie (lib/session.ts) with HMAC-SHA256. Required in
# production: without it nobody can sign in, by design. Any long random string,
# e.g. `node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"`.
SESSION_SECRET=

# Google OAuth 2.0 client (Web application) from console.cloud.google.com.
# Add <site>/auth/google/callback as an authorised redirect URI. Set
# GOOGLE_REDIRECT_URI only when the site is served on a host the app cannot
# infer from the request (an unusual proxy); otherwise leave it blank.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Local sign-in without Google, for development and for the repo's own verify
# scripts. Set to 1 on a developer machine only. /auth/dev answers 404 unless
# NODE_ENV is not production, this is exactly "1", and no NETLIFY environment
# variable is present, so a deployed build can never expose it.
PAWPAL_DEV_AUTH=

# libSQL database used by lib/runtime.ts.
# Hosted: a Turso database, e.g. libsql://<name>-<org>.turso.io, plus its token.
# Local: a SQLite file, e.g. file:.data/local.db (created by `node scripts/db-migrate.mjs`).
# Unset outside production, the app falls back to file:.data/local.db.
# Unset in production, the app serves the existing 503 instead of an empty shop.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# File store used by lib/runtime.ts for product images and payment slips.
# On Netlify nothing is needed: Netlify Blobs is detected and used automatically
# (NETLIFY_BLOBS_STORE overrides the store name, default "pawpal-media").
# Off Netlify, PAWPAL_BLOBS_DIR points at a plain directory; `next dev` falls
# back to .data/blobs on its own, so local development needs no account.
# Unset in production and not on Netlify, the app serves the existing 503.
PAWPAL_BLOBS_DIR=
NETLIFY_BLOBS_STORE=
